{
  "_comment_crons": [
    "═══════════════════════════════════════════════════════════════════",
    "  NOTIFICATION का समय — घंटे-वार, हर घंटे एक अलग तरह का reminder",
    "═══════════════════════════════════════════════════════════════════",
    "  Vercel UTC में चलता है. IST = UTC + 5:30",
    "  समय बदलना हो तो नीचे सिर्फ़ schedule का UTC समय बदलें:",
    "",
    "     IST      UTC      किसका reminder",
    "     10:00    04:30    service    (सुबह की सर्विस याद दिलाना)",
    "     11:00    05:30    payment    (सुबह का बकाया)",
    "     12:00    06:30    insurance  (Insurance renewal)",
    "     14:00    08:30    payment    (दोपहर — बकाया सबसे ज़रूरी)",
    "     15:00    09:30    service    (सर्विस)",
    "     16:00    10:30    insurance  (Insurance)",
    "     17:00    11:30    rto        (RTO बाक़ी)",
    "",
    "  type के मान: payment | service | insurance | rto | followup | all",
    "═══════════════════════════════════════════════════════════════════"
  ],
  "crons": [
    {
      "path": "/api/send-reminders?type=service&slot=1",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/send-reminders?type=payment&slot=2",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/send-reminders?type=insurance&slot=3",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/send-reminders?type=payment&slot=4",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/send-reminders?type=service&slot=5",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/send-reminders?type=insurance&slot=6",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/send-reminders?type=rto&slot=7",
      "schedule": "30 11 * * *"
    }
  ],
  "functions": {
    "api/send-reminders.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "_comment_rewrites": [
    "⚠️ यहीं 404 NOT_FOUND वाली दिक़्क़त थी.",
    "पहले destination \"/\" था — वह कोई असली file नहीं है, इसलिए Vercel",
    "/reminders जैसे किसी भी path पर अपना 404 दिखा देता था.",
    "अब \"/index.html\" है — यही असली file है जो पूरा React app चलाती है.",
    "",
    "इससे notification click, page refresh (F5) और सीधा URL खोलना —",
    "तीनों काम करते हैं. (?!api/) का मतलब है कि /api/… वाले रास्ते",
    "serverless functions के पास ही जाएँ, index.html पर न मुड़ें."
  ]
}
